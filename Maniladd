        FreeCamConn=RunService.RenderStepped:Connect(function(dt)
            local spd=State.FreeCamSpeed*50*dt; local cf=Camera.CFrame
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then Camera.CFrame=cf*CFrame.new(0,0,-spd) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then Camera.CFrame=cf*CFrame.new(0,0,spd) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then Camera.CFrame=cf*CFrame.new(-spd,0,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then Camera.CFrame=cf*CFrame.new(spd,0,0) end
