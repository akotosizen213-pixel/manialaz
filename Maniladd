local function CloseGUI()
    State.GuiOpen = false
    TweenService:Create(MainContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0,0,0,0),
        Position = UDim2.new(
            MainContainer.Position.X.Scale,
            MainContainer.Position.X.Offset + 230,
            MainContainer.Position.Y.Scale,
            MainContainer.Position.Y.Offset + 190
        )
    }):Play()
    task.wait(0.26)
    MainContainer.Visible = false
    OpenBtn.Visible = true
end

local function OpenGUI()
    State.GuiOpen = true
    MainContainer.Visible = true
    MainContainer.Size = UDim2.new(0,0,0,0)
    local cx = MainContainer.Position.X.Offset
    local cy = MainContainer.Position.Y.Offset
    TweenService:Create(MainContainer, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0,460,0,380),
    }):Play()
    OpenBtn.Visible = false
end

CloseBtn.MouseButton1Click:Connect(CloseGUI)
MinBtn.MouseButton1Click:Connect(CloseGUI)
OpenBtn.MouseButton1Click:Connect(OpenGUI)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if State.GuiOpen then CloseGUI() else OpenGUI() end
    end
end)

