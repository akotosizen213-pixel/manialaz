local function RemoveESPForPlayer(player)
    if State.ESPObjects[player] then
        for _,obj in pairs(State.ESPObjects[player]) do if obj then obj:Remove() end end
        State.ESPObjects[player] = nil
    end
end

local function UpdateESP()
    for _,player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not State.ESPObjects[player] then CreateESPForPlayer(player) end
        local objs = State.ESPObjects[player]
        local char = player.Character
        local lchar = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not State.ESP or not root or not head or not hum or hum.Health<=0 then
            for _,obj in pairs(objs) do obj.Visible=false end; continue
        end
        local headPos,headVis = Camera:WorldToViewportPoint(head.Position)
        local feetPos = Camera:WorldToViewportPoint(root.Position-Vector3.new(0,3,0))
        if not headVis then for _,obj in pairs(objs) do obj.Visible=false end; continue end
        local sx,sy = headPos.X,headPos.Y
        local bx,by = feetPos.X,feetPos.Y
        local height = math.abs(by-sy); local width = height*0.55
        local lroot = lchar and lchar:FindFirstChild("HumanoidRootPart")
        local dist = (root and lroot) and math.floor((root.Position-lroot.Position).Magnitude) or 0
        local hpRatio = math.clamp(hum.Health/hum.MaxHealth,0,1)
        local headRadius = math.max(4,height*0.12)
        objs.BoxFill.Position=Vector2.new(sx-width/2,sy); objs.BoxFill.Size=Vector2.new(width,height); objs.BoxFill.Visible=true
        objs.Box.Position=Vector2.new(sx-width/2,sy); objs.Box.Size=Vector2.new(width,height); objs.Box.Visible=true
        objs.Head.Position=Vector2.new(sx,sy-headRadius); objs.Head.Radius=headRadius; objs.Head.Visible=true
        objs.Name.Text=player.DisplayName; objs.Name.Position=Vector2.new(sx,sy-headRadius*2-4); objs.Name.Visible=true
        objs.Dist.Text=dist.."m"; objs.Dist.Position=Vector2.new(sx,by+3); objs.Dist.Visible=true
        local barX=sx-width/2-7
        objs.HPBg.Position=Vector2.new(barX-2,sy); objs.HPBg.Size=Vector2.new(4,height); objs.HPBg.Visible=true
        objs.HPBar.Position=Vector2.new(barX-2,sy+height*(1-hpRatio)); objs.HPBar.Size=Vector2.new(4,height*hpRatio)
        objs.HPBar.Color=Color3.fromRGB(math.floor(255*(1-hpRatio)),math.floor(255*hpRatio),30); objs.HPBar.Visible=true
        objs.Tracer.From=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y); objs.Tracer.To=Vector2.new(bx,by); objs.Tracer.Visible=true
    end
end

for _,p in pairs(Players:GetPlayers()) do CreateESPForPlayer(p) end
