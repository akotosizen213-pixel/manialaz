local CrossV = Drawing.new("Line"); CrossV.Visible=false; CrossV.Color=Color3.fromRGB(200,200,200); CrossV.Thickness=1.2

local function GetClosestPlayer()
    local closest,closestDist=nil,math.huge
    local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    for _,player in pairs(Players:GetPlayers()) do
        if player==LocalPlayer then continue end
        local char=player.Character; local part=char and char:FindFirstChild(State.AimPart)
        if not part then continue end
        local screen,vis=Camera:WorldToViewportPoint(part.Position)
        if not vis then continue end
        local dist=(Vector2.new(screen.X,screen.Y)-center).Magnitude
        if dist<State.AimbotFOV and dist<closestDist then closest=part; closestDist=dist end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    local cx=Camera.ViewportSize.X/2; local cy=Camera.ViewportSize.Y/2
    AimCircle.Position=Vector2.new(cx,cy); AimCircle.Radius=State.AimbotFOV; AimCircle.Visible=State.Aimbot
    CrossH.From=Vector2.new(cx-10,cy); CrossH.To=Vector2.new(cx+10,cy); CrossH.Visible=State.Aimbot
    CrossV.From=Vector2.new(cx,cy-10); CrossV.To=Vector2.new(cx,cy+10); CrossV.Visible=State.Aimbot
    if State.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target=GetClosestPlayer()
        if target then Camera.CFrame=Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position,target.Position),State.AimbotSmoothing) end
    end
end)

