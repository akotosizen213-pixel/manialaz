    Instance.new("UICorner", Underline).CornerRadius = UDim.new(0,2)

    local TabPage = Instance.new("ScrollingFrame")
    TabPage.Name = name.."Page"
    TabPage.Size = UDim2.new(1,0,1,0)
    TabPage.BackgroundTransparency = 1
    TabPage.BorderSizePixel = 0
    TabPage.ScrollBarThickness = 2
    TabPage.ScrollBarImageColor3 = Color3.fromRGB(60,60,60)
    TabPage.Visible = false
    TabPage.ZIndex = 2
    TabPage.Parent = ContentArea

    local PL = Instance.new("UIListLayout")
    PL.SortOrder = Enum.SortOrder.LayoutOrder
    PL.Padding = UDim.new(0,4)
    PL.Parent = TabPage

    local PP = Instance.new("UIPadding")
    PP.PaddingLeft = UDim.new(0,10)
    PP.PaddingTop = UDim.new(0,8)
    PP.PaddingRight = UDim.new(0,10)
    PP.Parent = TabPage

    PL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabPage.CanvasSize = UDim2.new(0,0,0,PL.AbsoluteContentSize.Y+16)
    end)

    TabBtn.MouseButton1Click:Connect(function()
        if ActiveTab then
            Tabs[ActiveTab].Page.Visible = false
            Tabs[ActiveTab].Btn.TextColor3 = Color3.fromRGB(80,80,80)
            Tabs[ActiveTab].Underline.Visible = false
        end
        ActiveTab = name
        TabPage.Visible = true
        TabBtn.TextColor3 = Color3.fromRGB(255,255,255)
        Underline.Visible = true
    end)

    Tabs[name] = {Btn=TabBtn, Page=TabPage, Underline=Underline}
    return TabPage
end

